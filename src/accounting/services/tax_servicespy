from decimal import Decimal


class TaxService:

    @staticmethod
    def compute_line_tax(line):

        if not line.tax:
            return Decimal("0")

        base = line.qty * line.price

        tax_rate = line.tax.rate / 100

        tax_amount = base * tax_rate

        return tax_amount
